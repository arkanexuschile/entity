# Base de datos PostgreSQL
DATABASE_URL="postgresql://entity:entity@localhost:5435/entity"

# Secreto de sesión (cambiar en producción)
SESSION_SECRET="dev-secret-entity"

# URL pública de la app (para enlaces en correos). Ej: https://entity.piedrabruja.cl
APP_BASE_URL="http://localhost:3000"

# ─── Notificaciones por correo (Resend) ─────────────────────────────
# Las completa el dueño cuando use la plataforma. Mientras no existan,
# el envío de correos se registra como "skipped" sin fallar.
RESEND_API_KEY=""
# Remitente verificado en Resend. Ej: "Entity <noreply@tudominio.cl>"
RESEND_FROM=""

# ─── Origen DTE (proxy PDF) — si se deja vacío, /api/ventas/:id/pdf devuelve vista imprimible ─
LORIEN_API_URL=""
LORIEN_API_KEY=""
DEFONTANA_API_URL=""
DEFONTANA_API_KEY=""
