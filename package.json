{
  "name": "entity",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @entity/database db:generate",
    "db:migrate": "pnpm --filter @entity/database db:migrate",
    "db:seed": "pnpm --filter @entity/database db:seed",
    "db:studio": "pnpm --filter @entity/database db:studio"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.28.2",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@11.9.0"
}